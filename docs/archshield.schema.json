{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchShield configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1, "default": "." }
      }
    },
    "include": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"]
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": [
        "**/node_modules/**",
        "**/.git/**",
        "**/dist/**",
        "**/coverage/**",
        "**/vendor/**"
      ]
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typescript": {
          "$ref": "#/$defs/language",
          "default": { "enabled": true }
        },
        "javascript": {
          "$ref": "#/$defs/language",
          "default": { "enabled": true }
        },
        "php": { "$ref": "#/$defs/language", "default": { "enabled": false } },
        "python": {
          "$ref": "#/$defs/language",
          "default": { "enabled": false }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" },
      "default": []
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "default": []
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileSizeKb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 1000
        },
        "followSymlinks": { "type": "boolean", "default": false },
        "unresolvedImports": {
          "enum": ["warn", "error", "ignore"],
          "default": "warn"
        },
        "caseSensitivePaths": { "type": "boolean", "default": true },
        "allowAmbiguousLayers": { "type": "boolean", "default": false }
      }
    }
  },
  "$defs": {
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "patterns"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ruleBase": {
      "type": "object",
      "required": ["id", "type", "severity"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "rule": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/ruleBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "type": { "const": "layer-boundary" },
                "severity": { "enum": ["error", "warning", "info"] },
                "message": { "type": "string", "minLength": 1 },
                "from": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "to": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "severity", "from", "patterns"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "type": { "const": "forbidden-import" },
            "severity": { "enum": ["error", "warning", "info"] },
            "message": { "type": "string", "minLength": 1 },
            "from": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "patterns": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "match": {
              "enum": ["specifier", "path", "both"],
              "default": "both"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "severity", "from", "allowed"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "type": { "const": "allowed-dependency" },
            "severity": { "enum": ["error", "warning", "info"] },
            "message": { "type": "string", "minLength": 1 },
            "from": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "allowed": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "match": { "enum": ["layer", "path", "both"], "default": "both" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "severity"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "type": { "const": "no-cycles" },
            "severity": { "enum": ["error", "warning", "info"] },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
